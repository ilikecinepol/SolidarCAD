+void ToolParameterHud::showEvent(QShowEvent* event) {
+  QWidget::showEvent(event);
+
+  // Numeric entry is the primary interaction once a 3D tool HUD appears:
+  // make the first editable value immediately ready for replacement so the
+  // user can type a number and press Enter without an initial Tab/click.
+  QTimer::singleShot(0, this, [this] {
+    if (!isVisible() || orderedEditors_.empty()) return;
+    focusFirstField();
+  });
+}
+
 void ToolParameterHud::clearEditors() {
