+double normalizedArcAngle(double angle) noexcept {
+  constexpr double kTwoPi = 6.28318530717958647692;
+  angle = std::fmod(angle, kTwoPi);
+  if (angle < 0.0) angle += kTwoPi;
+  return angle;
+}
+
+std::optional<Arc> arcThroughConstraintPoints(Point first,
+                                              Point through,
+                                              Point last) {
+  const double determinant = 2.0 *
+      (first.xMm * (through.yMm - last.yMm) +
+       through.xMm * (last.yMm - first.yMm) +
+       last.xMm * (first.yMm - through.yMm));
+  if (std::abs(determinant) <= 1e-12) return std::nullopt;
+
+  const double a = first.xMm * first.xMm + first.yMm * first.yMm;
+  const double b = through.xMm * through.xMm + through.yMm * through.yMm;
+  const double c = last.xMm * last.xMm + last.yMm * last.yMm;
+
+  const Point center{
+      (a * (through.yMm - last.yMm) +
+       b * (last.yMm - first.yMm) +
+       c * (first.yMm - through.yMm)) / determinant,
+      (a * (last.xMm - through.xMm) +
+       b * (first.xMm - last.xMm) +
+       c * (through.xMm - first.xMm)) / determinant};
+
+  const double radius =
+      std::hypot(first.xMm - center.xMm, first.yMm - center.yMm);
+  if (!std::isfinite(radius) || radius <= 1e-9) return std::nullopt;
+
+  constexpr double kTwoPi = 6.28318530717958647692;
+  const double start = normalizedArcAngle(
+      std::atan2(first.yMm - center.yMm, first.xMm - center.xMm));
+  const double middle = normalizedArcAngle(
+      std::atan2(through.yMm - center.yMm, through.xMm - center.xMm));
+  const double end = normalizedArcAngle(
+      std::atan2(last.yMm - center.yMm, last.xMm - center.xMm));
+
+  const double ccwSweep = normalizedArcAngle(end - start);
+  const double middleFromStart = normalizedArcAngle(middle - start);
+  if (ccwSweep > 1e-9 && middleFromStart <= ccwSweep + 1e-9)
+    return Arc{center, radius, start, ccwSweep, false};
+
+  const double reverseSweep = normalizedArcAngle(start - end);
+  if (reverseSweep <= 1e-9 || reverseSweep >= kTwoPi - 1e-9)
+    return std::nullopt;
+  return Arc{center, radius, end, reverseSweep, false};
+}
