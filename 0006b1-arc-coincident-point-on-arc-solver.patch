+double finiteArcDistance(Point point, const Arc& arc) {
+  if (!std::isfinite(arc.radiusMm) || arc.radiusMm <= 1e-12 ||
+      arc.sweepAngleRad <= 1e-12)
+    return kDegeneratePenalty;
+
+  constexpr double kTwoPi = 6.28318530717958647692;
+  const auto normalize = [](double angle) {
+    constexpr double twoPi = 6.28318530717958647692;
+    angle = std::fmod(angle, twoPi);
+    if (angle < 0.0) angle += twoPi;
+    return angle;
+  };
+
+  const double dx = point.xMm - arc.center.xMm;
+  const double dy = point.yMm - arc.center.yMm;
+  const double length = std::hypot(dx, dy);
+  if (length <= 1e-12) return arc.radiusMm;
+
+  const double angle = normalize(std::atan2(dy, dx));
+  const double delta = normalize(angle - normalize(arc.startAngleRad));
+  if (delta <= arc.sweepAngleRad + 1e-12)
+    return std::abs(length - arc.radiusMm);
+
+  const Point start = arcStartPoint(arc);
+  const Point end = arcEndPoint(arc);
+  return std::min(pointDistance(point, start),
+                  pointDistance(point, end));
+}
