+  const Point opposite = start ? arcEndPoint(arc) : arcStartPoint(arc);
+  const double middleAngle = arc.startAngleRad + arc.sweepAngleRad * 0.5;
+  const Point through{
+      arc.center.xMm + arc.radiusMm * std::cos(middleAngle),
+      arc.center.yMm + arc.radiusMm * std::sin(middleAngle)};
+
+  auto rebuilt = start
+      ? arcThroughConstraintPoints(target, through, opposite)
+      : arcThroughConstraintPoints(opposite, through, target);
+  if (!rebuilt) return false;
+
+  rebuilt->dashed = arc.dashed;
+  arc = *rebuilt;
+  return true;
+}
