+bool Sketch::setPointOnArc(GeometryId arcIdValue,
+                           PointReference pointReference) {
+  const auto carrierIndex = arcIndex(arcIdValue);
+  const auto point = referencedPoint(pointReference);
+
+  if (isPointReferenceLocked(pointReference)) return false;
+  if (!carrierIndex || !point) return false;
+
+  // An endpoint already belongs to its own carrier by definition.
+  if (pointReference.arcId == arcIdValue) return false;
+
+  const Arc& carrier = arcs_[*carrierIndex];
+  if (!std::isfinite(carrier.radiusMm) || carrier.radiusMm <= 1e-9 ||
+      carrier.sweepAngleRad <= 1e-9)
+    return false;
+
+  const Point startPoint = arcStartPoint(carrier);
+  const Point endPoint = arcEndPoint(carrier);
+  double dx = point->xMm - carrier.center.xMm;
+  double dy = point->yMm - carrier.center.yMm;
+  const double length = std::hypot(dx, dy);
+
+  Point target{};
+  if (length <= 1e-12) {
+    target = startPoint;
+  } else {
+    const double angle = normalizedArcAngle(std::atan2(dy, dx));
+    const double start = normalizedArcAngle(carrier.startAngleRad);
+    const double delta = normalizedArcAngle(angle - start);
+
+    if (delta <= carrier.sweepAngleRad + 1e-9) {
+      target = {carrier.center.xMm + carrier.radiusMm * dx / length,
+                carrier.center.yMm + carrier.radiusMm * dy / length};
+    } else {
+      const double toStart = std::hypot(point->xMm - startPoint.xMm,
+                                        point->yMm - startPoint.yMm);
+      const double toEnd = std::hypot(point->xMm - endPoint.xMm,
+                                      point->yMm - endPoint.yMm);
+      target = toStart <= toEnd ? startPoint : endPoint;
+    }
+  }
+
+  const Point oldPoint = *point;
+  const double moveX = target.xMm - oldPoint.xMm;
+  const double moveY = target.yMm - oldPoint.yMm;
+
+  if (pointReference.elementCenterId != 0) {
+    for (auto& line : lines_) {
+      if (line.elementId != pointReference.elementCenterId) continue;
+      line.start.xMm += moveX;
+      line.start.yMm += moveY;
+      line.end.xMm += moveX;
+      line.end.yMm += moveY;
+    }
+  } else if (pointReference.circleId != kInvalidGeometryId) {
+    const auto movingCircle = circleIndex(pointReference.circleId);
+    if (!movingCircle) return false;
+    circles_[*movingCircle].center = target;
+  } else if (pointReference.arcId != kInvalidGeometryId) {
+    const auto movingArc = arcIndex(pointReference.arcId);
+    if (!movingArc) return false;
+    if (!moveArcEndpoint(arcs_[*movingArc], pointReference.start, target))
+      return false;
+  } else {
+    const auto same = [](Point first, Point second) {
+      return std::hypot(first.xMm - second.xMm,
+                        first.yMm - second.yMm) <= 1e-7;
+    };
+    for (auto& line : lines_) {
+      if (same(line.start, oldPoint)) line.start = target;
+      if (same(line.end, oldPoint)) line.end = target;
+    }
+    for (auto& circle : circles_) {
+      if (same(circle.center, oldPoint)) circle.center = target;
+    }
+  }
+
+  updateBounds();
+  return true;
+}
