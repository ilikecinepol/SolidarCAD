+bool moveArcEndpoint(Arc& arc, bool start, Point target) {
+  const Point current = start ? arcStartPoint(arc) : arcEndPoint(arc);
+  if (std::hypot(current.xMm - target.xMm,
+                 current.yMm - target.yMm) <= 1e-9)
+    return true;
